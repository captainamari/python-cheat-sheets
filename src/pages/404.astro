---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/urls';
---

<Layout title="没有找到这个页面">
  <div class="wrap page-narrow empty-state">
    <p class="eyebrow accent">404</p>
    <h1>这个页面暂时找不到。</h1>
    <p class="page-intro">回到知识库，或搜索你想了解的内容。</p>
    <div class="hero-actions">
      <a class="button primary" href={url()}>
        返回知识库
      </a>
      <a class="text-link" href={url('search/')}>
        搜索内容
      </a>
    </div>
  </div>
</Layout>
