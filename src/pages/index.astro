---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TopicCard from '../components/TopicCard.astro';
import { categories } from '../lib/catalog';
import { url } from '../lib/urls';
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const paths = await getCollection('paths');
const questions = await getCollection('questions');
const totalQuestions = questions.reduce((n, q) => n + q.data.questions.length, 0);
---

<Layout>
  <div class="wrap home">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow accent">PYTHON / 学习与面试</p>
        <h1>
          读懂代码，
          <br />
          也能把它<span>讲清楚。</span>
        </h1>
        <p class="hero-description">
          从一个问题出发，理解原理、运行示例，再用练习检验自己。
          <br class="desktop-only" />
          为下一次面试，也为每天的开发。
        </p>
        <div class="hero-actions">
          <a class="button primary" id="continue-link" href={url(`topics/${topics[0].id}/`)}>
            开始学习
          </a>
          <a class="text-link" href={url('practice/')}>
            做一组练习
          </a>
        </div>
        <div class="hero-stats">
          <span>
            <b>{topics.length}</b> 个知识点
          </span>
          <span>
            <b>{totalQuestions}</b> 道练习
          </span>
          <span>
            <b>4</b> 种练习方式
          </span>
        </div>
      </div>
      <div class="code-note" aria-label="Python 可变默认参数示例">
        <div class="code-note-bar">
          <span>一个值得想明白的问题</span>
          <span class="mono">.py</span>
        </div>
        <pre><code><span class="code-muted"># 为什么第二次调用不是独立列表？</span>{'\n\n'}<span class="code-keyword">def</span> <span class="code-function">collect</span>(value, items=[]):{'\n'}    items.append(value){'\n'}    <span class="code-keyword">return</span> items{'\n\n'}collect(<span class="code-string">"python"</span>){'\n'}collect(<span class="code-string">"testing"</span>)</code></pre>
        <a href={url('topics/mutable-defaults/')} class="code-note-footer">
          理解默认值的求值时机 <span class="pill">语言与对象</span>
        </a>
      </div>
    </section>
    <section class="path-section" aria-labelledby="path-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">从这里开始</p>
          <h2 id="path-title">选一条学习路线</h2>
        </div>
        <p>同一份知识，按你的目标组织。</p>
      </div>
      <div class="path-grid">
        {paths.map((path) => (
          <a class="path-card" href={url(`paths/${path.id}/`)}>
            <span class="eyebrow">{path.data.topics.length} 个知识点</span>
            <h3>{path.data.title}</h3>
            <p>{path.data.description}</p>
            <span class="path-action">查看路线</span>
          </a>
        ))}
      </div>
    </section>
    <section class="library-section" id="library" aria-labelledby="library-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">循序深入</p>
          <h2 id="library-title">知识库</h2>
        </div>
        <p id="filter-count" aria-live="polite">
          {topics.length} 个知识点
        </p>
      </div>
      <div class="library-layout">
        <aside class="category-filter">
          <label class="mobile-label" for="category-select">
            知识分类
          </label>
          <select id="category-select" class="mobile-category">
            <option value="all">全部知识点</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
          <div class="category-buttons" role="group" aria-label="知识分类">
            <button class="category-button active" data-filter="all" aria-pressed="true">
              <span>全部知识点</span>
              <b>{topics.length}</b>
            </button>
            {categories.map((c) => (
              <button class="category-button" data-filter={c.id} aria-pressed="false">
                <span>{c.name}</span>
                <b>{topics.filter((t) => t.data.category === c.id).length}</b>
              </button>
            ))}
          </div>
          <div class="side-note">
            <span class="eyebrow">学会，而不只是读过</span>
            <p>先独立思考，再看解析。阅读与练习记录分别保存。</p>
          </div>
        </aside>
        <div class="topic-list">
          {topics.map((topic) => (
            <TopicCard topic={topic} />
          ))}
          <p id="empty-filter" class="empty-state" hidden>
            这个分类还没有知识点。
          </p>
        </div>
      </div>
    </section>
  </div>
  <script>
    import { readProgress, PROGRESS_KEY } from '../lib/progress';
    import { url } from '../lib/urls';
    function update() {
      const p = readProgress();
      document.querySelectorAll<HTMLElement>('[data-read-state]').forEach((el) => {
        const read = !!p.topics[el.dataset.readState!]?.readAt;
        el.textContent = read ? '已阅读' : '未阅读';
        el.classList.toggle('is-read', read);
      });
      const link = document.getElementById('continue-link') as HTMLAnchorElement;
      if (p.lastTopic && document.querySelector(`[data-topic-card="${p.lastTopic}"]`)) {
        link.href = url(`topics/${p.lastTopic}/`);
        link.textContent = '继续学习';
      }
    }
    update();
    window.addEventListener('storage', (e) => {
      if (e.key === PROGRESS_KEY) update();
    });
    function filter(category: string) {
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-topic-card]').forEach((el) => {
        const show = category === 'all' || el.dataset.category === category;
        el.hidden = !show;
        if (show) count++;
      });
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((el) => {
        const active = el.dataset.filter === category;
        el.classList.toggle('active', active);
        el.setAttribute('aria-pressed', String(active));
      });
      (document.getElementById('category-select') as HTMLSelectElement).value = category;
      document.getElementById('filter-count')!.textContent = `${count} 个知识点`;
      document.getElementById('empty-filter')!.hidden = count !== 0;
    }
    document
      .querySelectorAll<HTMLButtonElement>('[data-filter]')
      .forEach((el) => el.addEventListener('click', () => filter(el.dataset.filter!)));
    document
      .getElementById('category-select')!
      .addEventListener('change', (e) => filter((e.target as HTMLSelectElement).value));
  </script>
</Layout>
