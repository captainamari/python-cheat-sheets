---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/urls';
const topics = (await getCollection('topics'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({ id: t.id, title: t.data.title }));
const questions = (await getCollection('questions')).flatMap((s) => s.data.questions);
---

<Layout title="学习记录" active="review">
  <div class="wrap review-page">
    <a class="breadcrumb" href={url()}>
      知识库 / 学习记录
    </a>
    <p class="eyebrow accent">把理解留到下一次</p>
    <h1>读过，练过，再讲一遍。</h1>
    <p class="page-intro">收藏想读的，重练没说清的。阅读、客观成绩与开放题自评分别记录。</p>
    <div id="review-summary" class="result-stats"></div>
    <div id="review-filters" class="review-filters" role="group" aria-label="学习记录筛选"></div>
    <div id="review-actions" class="hero-actions"></div>
    <p id="review-description" class="muted"></p>
    <div id="review-list" class="review-list" aria-live="polite"></div>
    <section class="backup-panel" aria-labelledby="backup-title">
      <p class="eyebrow accent">随身携带你的记录</p>
      <h2 id="backup-title">备份与迁移</h2>
      <p>记录保存在当前浏览器。导出 JSON 后可在另一台设备导入；清除网站数据前请先备份。</p>
      <div class="hero-actions">
        <button id="export-progress" class="button secondary">
          导出学习记录
        </button>
        <label class="button secondary" for="import-progress">
          选择备份文件
        </label>
        <input id="import-progress" type="file" accept="application/json,.json" />
        <button id="export-previous" class="small-button" hidden>
          下载上次导入前的记录
        </button>
      </div>
      <div id="import-preview" class="import-preview" hidden></div>
      <p id="backup-status" role="status" aria-live="polite"></p>
      <details class="review-help">
        <summary>复习安排与历史记录说明</summary>
        <p>
          答错或自评“还需复习”会立即到期；“能说出部分”安排在 1
          天后。连续答对或能独立说明，分别安排在 1、3、7、14 天后；之后保持 14
          天间隔。到期按作答时刻计算，是复习建议，不代表已掌握。
        </p>
        <p>
          错题队列只看每题最近一次客观作答，开放题单独巩固。S1 的阅读和累计成绩保留；逐题记录从 S2
          开始，无法从旧累计成绩还原错题。请在一个标签页中作答，避免同时写入覆盖彼此记录。
        </p>
        <p>
          导入会替换当前记录，不累加成绩；确认前会显示内容预览。替换前保留一份本地原始记录，可下载后重新导入。无法识别或损坏的文件不会导入。未知知识点和题目会跳过并提示。
        </p>
      </details>
    </section>
    <script
      id="review-data"
      type="application/json"
      set:html={JSON.stringify({ topics, questions }).replace(/</g, '\u003c')}
    />
    <noscript>
      <p>学习记录需要 JavaScript。</p>
    </noscript>
  </div>
  <script src="../../scripts/review.ts" />
</Layout>
