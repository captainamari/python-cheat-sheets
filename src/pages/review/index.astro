---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/urls';
const topics = (await getCollection('topics'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({ id: t.id, title: t.data.title }));
---

<Layout title="学习记录" active="review">
  <div class="wrap review-page">
    <a class="breadcrumb" href={url()}>
      知识库 / 学习记录
    </a>
    <p class="eyebrow accent">看见自己的进步</p>
    <h1>读过，练过，再讲一遍。</h1>
    <p class="page-intro">
      阅读、客观题作答与最近一次开放题自评分别保存。
      <br />
      这些记录属于当前浏览器，清除网站数据会移除记录。
    </p>
    <div id="review-summary" class="result-stats"></div>
    <div id="review-list" class="review-list"></div>
    <script
      type="application/json"
      id="review-data"
      set:html={JSON.stringify(topics).replace(/</g, '\\u003c')}
    />
    <noscript>
      <p>学习记录需要 JavaScript。</p>
    </noscript>
  </div>
  <script>
    import { readProgress, PROGRESS_KEY } from '../../lib/progress';
    import { url } from '../../lib/urls';
    const topics = JSON.parse(document.getElementById('review-data')!.textContent!) as {
      id: string;
      title: string;
    }[];
    function render() {
      const p = readProgress();
      const active = topics.filter((t) => p.topics[t.id]);
      const total = active.reduce(
        (s, t) => {
          const v = p.topics[t.id];
          return {
            read: s.read + (v.readAt ? 1 : 0),
            attempts: s.attempts + v.objective.attempts,
            correct: s.correct + v.objective.correct,
          };
        },
        { read: 0, attempts: 0, correct: 0 },
      );
      const summary = document.getElementById('review-summary')!;
      summary.replaceChildren();
      for (const [value, label] of [
        [`${total.read} / ${topics.length}`, '已阅读知识点'],
        [String(total.attempts), '客观题累计作答'],
        [
          total.attempts ? `${Math.round((total.correct / total.attempts) * 100)}%` : '—',
          '客观题累计正确率',
        ],
      ]) {
        const div = document.createElement('div');
        const strong = document.createElement('strong');
        strong.textContent = value;
        const span = document.createElement('span');
        span.textContent = label;
        div.append(strong, span);
        summary.append(div);
      }
      const list = document.getElementById('review-list')!;
      list.replaceChildren();
      if (!active.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-state';
        const h = document.createElement('h2');
        h.textContent = '从一个问题开始';
        const a = document.createElement('a');
        a.className = 'button primary';
        a.href = url();
        a.textContent = '浏览知识库';
        empty.append(h, a);
        list.append(empty);
        return;
      }
      for (const t of active) {
        const v = p.topics[t.id];
        const row = document.createElement('div');
        row.className = 'review-row';
        const a = document.createElement('a');
        a.href = url(`topics/${t.id}/`);
        a.textContent = t.title;
        const details = document.createElement('p');
        details.textContent = [
          v.readAt ? '已阅读' : '未标记阅读',
          v.objective.attempts
            ? `客观题 ${v.objective.correct}/${v.objective.attempts} 次答对`
            : '尚未作答客观题',
          v.self
            ? `最近自评：${{ again: '还需复习', partial: '能说出部分', confident: '能独立说明' }[v.self]}`
            : '尚未自评',
        ].join(' · ');
        const practice = document.createElement('a');
        practice.href = url(`practice/?topic=${t.id}`);
        practice.className = 'small-button';
        practice.textContent = '练习';
        const text = document.createElement('div');
        text.append(a, details);
        row.append(text, practice);
        list.append(row);
      }
    }
    render();
    window.addEventListener('storage', (e) => {
      if (e.key === PROGRESS_KEY) render();
    });
  </script>
</Layout>
