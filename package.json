{
  "name": "python-cheat-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "npm run art:build && npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview --ignore-lock",
    "check": "astro check",
    "validate": "node --import tsx scripts/validate-content.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:examples": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:site": "node scripts/verify-site.mjs",
    "test:e2e": "playwright test",
    "test:outputs": "node --import tsx scripts/verify-output-questions.ts",
    "format": "prettier --write .",
    "art:build": "node --import tsx scripts/build-art.ts"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
